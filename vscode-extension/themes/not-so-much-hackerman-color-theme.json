    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#6a6e95"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "entity.name.variable.local"
            ],
            "settings": {
                "foreground": "#4fe0a0"
            }
        },
        {
            "name": "Parameters",
            "scope": [
